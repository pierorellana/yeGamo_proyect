NODE_ENV=development
PORT=3000
APP_VERSION=1.1.1
DATABASE_URL=postgresql://localhost:5432/yegamo
OIDC_ISSUER_URL=https://issuer.example.com/
OIDC_AUDIENCE=yegamo-api
OIDC_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
OVERPASS_ENABLED=true
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_BASE_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_MS=20000
OVERPASS_CACHE_TTL_MS=900000
